{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/story/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, noimageindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/story-preview",
      "destination": "https://portfolio-making-mike.vercel.app/story/"
    },
    {
      "source": "/story-preview/:path*",
      "destination": "https://portfolio-making-mike.vercel.app/story/:path*"
    }
  ]
}
